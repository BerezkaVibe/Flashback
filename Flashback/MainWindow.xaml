<Window x:Class="Flashback.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Flashback" Icon="Assets/Flashback.ico" Width="960" Height="760" MinWidth="760" MinHeight="640" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="14" AllowDrop="True" PreviewDragOver="ImportVideo_DragOver" PreviewDrop="ImportVideo_Drop" WindowStartupLocation="CenterScreen">
 <Grid Background="{DynamicResource AppBackground}"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border Background="{DynamicResource AppBackground}" BorderThickness="0"><Grid Margin="15,26,15,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><Border Width="32" Height="3" Background="{DynamicResource Accent}" CornerRadius="2" Margin="0,0,0,32"/><Button x:Name="CaptureNav" Style="{StaticResource IconButton}" Content="&#xE8B2;" ToolTip="Clips" AutomationProperties.Name="Clips" Click="Navigate_Click" Tag="0" Margin="0,0,0,12"/><Button x:Name="TrimNav" Style="{StaticResource IconButton}" Content="&#xE8C6;" ToolTip="Trim video" AutomationProperties.Name="Trim video" Click="OpenTrim_Click" Margin="0,0,0,12"/><Button x:Name="ClipsNav" Visibility="Collapsed" Style="{StaticResource IconButton}" Content="&#xE8B2;" ToolTip="Saved clips" AutomationProperties.Name="Saved clips" Click="Navigate_Click" Tag="0"/></StackPanel>
 <Button x:Name="SettingsNav" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Navigate_Click" Tag="1" Grid.Row="2"/>
 </Grid></Border>
 <Grid Grid.Column="1" Margin="28,24,28,18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,28"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/Flashback.ico" Width="34" Height="34" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="Flashback" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/><Button x:Name="UpdateButton" Visibility="Collapsed" Style="{StaticResource IconButton}" Width="30" Height="30" MinHeight="30" FontSize="15" Content="&#xE896;" Foreground="#3FB950" Margin="10,3,0,0" VerticalAlignment="Center" Click="Update_Click" AutomationProperties.Name="Install update"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="HeaderCapture" FontSize="12" HorizontalAlignment="Right" ToolTip="Recording frame rate, not game FPS."/><TextBlock x:Name="HeaderVersion" FontSize="11" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,5,0,0"/></StackPanel></Grid>
 <Grid Grid.Row="1" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Clips" FontSize="26" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="#9DA6B1" Margin="0,0,8,0"/><TextBlock x:Name="StatusTitle" Text="Paused" Foreground="{DynamicResource Muted}" FontSize="12"/><Border Background="{DynamicResource ControlSurface}" CornerRadius="4" Padding="7,2" Margin="12,-2,0,-2"><TextBlock x:Name="HotkeyLabel" Foreground="{DynamicResource Accent}" FontSize="11" ToolTip="Save clip shortcut"/></Border></StackPanel><TextBlock x:Name="PageSubtitle" Visibility="Collapsed"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="SpeakerButton" Style="{StaticResource IconButton}" Content="&#xE767;" ToolTip="Speaker audio" AutomationProperties.Name="Speaker audio" Click="QuickAudio_Click" Tag="speaker" Margin="0,0,4,0"/><Button x:Name="MicrophoneButton" Style="{StaticResource IconButton}" Content="&#xE720;" ToolTip="Microphone" AutomationProperties.Name="Microphone" Click="QuickAudio_Click" Tag="mic" Margin="0,0,12,0"/><Button x:Name="TopSaveButton" FontSize="12" Padding="12,8" ToolTip="Save replay" AutomationProperties.Name="Save replay" Click="Save_Click" IsEnabled="False" Background="{DynamicResource ControlSurface}" BorderBrush="{DynamicResource Outline}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><Canvas Width="16" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"><Path Data="M1.5,6.5 H14.5 V13 H1.5 Z" Stroke="{DynamicResource Ink}" StrokeThickness="1.3" StrokeLineJoin="Round"/><Path Data="M1.5,3.5 H14.5 V6 H1.5 Z M5.5,3.5 L4,6 M9.5,3.5 L8,6 M13.5,3.5 L12,6" Stroke="{DynamicResource Ink}" StrokeThickness="1.3" StrokeLineJoin="Round"><Path.RenderTransform><RotateTransform x:Name="ClapperTilt" Angle="-14" CenterX="1.5" CenterY="6"/></Path.RenderTransform></Path></Canvas><TextBlock Text="Save replay" VerticalAlignment="Center"/></StackPanel></Button><Button x:Name="ToggleButton" FontSize="12" Padding="12,8" ToolTip="Start recording" AutomationProperties.Name="Start recording" Click="Toggle_Click" Background="{DynamicResource ControlSurface}" BorderBrush="{DynamicResource Outline}"><StackPanel Orientation="Horizontal"><Ellipse x:Name="RecordDot" Width="8" Height="8" Fill="#5A636E" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="RecordLabel" Text="Record" VerticalAlignment="Center"/></StackPanel></Button></StackPanel></Grid>
 <TabControl x:Name="MainTabs" SelectedIndex="0" Foreground="{DynamicResource Ink}" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="MainTabs_SelectionChanged"><TabControl.Template><ControlTemplate TargetType="TabControl"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></ControlTemplate></TabControl.Template>
 <TabItem x:Name="LibraryTab" Header="Saved clips"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ClipSearch" ToolTip="Search game or filename" AutomationProperties.Name="Search game or filename" TextChanged="ClipSearch_Changed"/><Button  Style="{StaticResource IconButton}" Content="&#xE721;" ToolTip="Search by game or filename" AutomationProperties.Name="Search by game or filename" Click="FocusSearch_Click" HorizontalAlignment="Right" Margin="0,0,2,0"/><Button  Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Refresh clips" AutomationProperties.Name="Refresh clips" Click="RefreshClips_Click" Grid.Column="1" Margin="8,0,0,0"/><Button  Style="{StaticResource IconButton}" Content="&#xED25;" ToolTip="Open clips folder" AutomationProperties.Name="Open clips folder" Click="OpenFolder_Click" Grid.Column="2"/></Grid>
 <Grid Grid.Row="1"><ListBox x:Name="LibraryList" BorderThickness="0" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="Library_SelectionChanged" MouseDoubleClick="Library_DoubleClick" KeyDown="Library_KeyDown"><ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="184"/><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><Border Background="{DynamicResource ControlSurface}" CornerRadius="6" Width="168" Height="94" HorizontalAlignment="Left" ClipToBounds="True"><Grid><TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Stretch="Uniform" Loaded="Thumbnail_Loaded" DataContextChanged="Thumbnail_DataContextChanged" IsVisibleChanged="Thumbnail_VisibilityChanged" AutomationProperties.Name="Clip thumbnail"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Game}" FontWeight="SemiBold"/><Grid Margin="0,6,12,0" HorizontalAlignment="Left"><TextBlock Text="{Binding Name}" Tag="rename" TextTrimming="CharacterEllipsis" FontSize="12" Background="Transparent" Cursor="IBeam" ToolTip="Click to rename · F2" MouseLeftButtonDown="ClipName_MouseDown"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="TextDecorations" Value="Underline"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBox Visibility="Collapsed" FontSize="12" MinWidth="240" Padding="3,1" Margin="-4,-3,0,-3" KeyDown="ClipRename_KeyDown" LostKeyboardFocus="ClipRename_LostFocus" AutomationProperties.Name="Clip name"/></Grid></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock Text="{Binding DateLabel}" FontSize="12"/><TextBlock Text="{Binding SizeLabel}" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Right" Margin="0,6,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
 <StackPanel x:Name="LibraryEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False"><TextBlock Text="&#xE8B2;" FontFamily="Segoe MDL2 Assets" FontSize="38" Foreground="#4C5B65" HorizontalAlignment="Center"/><TextBlock x:Name="LibraryEmptyTitle" Text="Your plays, all in one place" FontSize="18" HorizontalAlignment="Center" Margin="0,18,0,8"/><TextBlock Text="Save a replay to get started." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/></StackPanel></Grid>
 <Border Grid.Row="2" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,16,0,0"><StackPanel><TextBlock x:Name="LibrarySummary" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/><WrapPanel x:Name="LibraryActions" IsEnabled="False"><Button  Style="{StaticResource IconButton}" Content="&#xE768;" ToolTip="Play clip" AutomationProperties.Name="Play clip" Click="LibraryPlay_Click" /><Button  Style="{StaticResource IconButton}" Content="&#xE8C6;" ToolTip="Trim and combine sections" AutomationProperties.Name="Trim and combine sections" Click="LibraryTrim_Click" /><Button  Style="{StaticResource IconButton}" Content="&#xED25;" ToolTip="Show clip in folder" AutomationProperties.Name="Show clip in folder" Click="LibraryReveal_Click" /><Button x:Name="ExternalEditButton" Style="{StaticResource IconButton}" Content="&#xE8A7;" ToolTip="Open in external editor" AutomationProperties.Name="Open in external editor" Click="ExternalEdit_Click" IsEnabled="False"/><Button  Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="Delete clip" AutomationProperties.Name="Delete clip" Click="LibraryDelete_Click" Margin="12,0,0,0"/></WrapPanel></StackPanel></Border>
 </Grid></TabItem>
    <TabItem Header="Settings">
    <Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl x:Name="SettingsPanel" Style="{StaticResource SideTabs}" SelectedIndex="0">
     <TabItem x:Name="RecordingSettings" Header="Video" Style="{StaticResource SideTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
      <TextBlock Text="Video" Style="{StaticResource SettingsHeading}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
       <StackPanel Margin="0,0,0,16"><DockPanel><TextBlock Text="Replay length" Style="{StaticResource Caption}"/><TextBlock x:Name="ReplayLengthLabel" HorizontalAlignment="Right" Foreground="{DynamicResource Accent}"/></DockPanel><Slider x:Name="LengthSlider" Minimum="30" Maximum="300" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="30" IsMoveToPointEnabled="True" ValueChanged="ReplayLength_Changed" AutomationProperties.Name="Replay length in seconds" Height="36"/><TextBlock Text="30 seconds – 5 minutes · 5-second steps" FontSize="11" Foreground="{DynamicResource Muted}"/></StackPanel>
       <StackPanel Grid.Column="2" Margin="0,0,0,16"><TextBlock Text="Frame rate (FPS / Hz)" Style="{StaticResource Caption}"/><ComboBox x:Name="FpsBox"/></StackPanel>
       <StackPanel Grid.Row="1" Margin="0,0,0,16"><TextBlock Text="Resolution (maximum height)" Style="{StaticResource Caption}"/><ComboBox x:Name="ResolutionBox"/></StackPanel>
       <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16"><TextBlock Text="Quality" Style="{StaticResource Caption}"/><ComboBox x:Name="QualityBox"/></StackPanel>
       <StackPanel Grid.Row="2"><TextBlock Text="Display to record" Style="{StaticResource Caption}"/><ComboBox x:Name="DisplayBox"/></StackPanel>
       <StackPanel Grid.Row="2" Grid.Column="2"><TextBlock Text="Hardware encoder" Style="{StaticResource Caption}"/><ComboBox x:Name="EncoderBox"/></StackPanel>
      </Grid>
      <CheckBox x:Name="CursorCheck" Content="Include mouse cursor" Margin="0,16,0,4"/>
      <TextBlock Text="Automatic checks NVIDIA NVENC or AMD AMF and prefers the display’s GPU. Lower FPS and resolution reduce capture work. Resolution preserves aspect ratio and never upscales." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
      <TextBlock x:Name="EstimateLabel" Margin="0,8,0,12" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem x:Name="AudioSettings" Header="Audio" Style="{StaticResource SideTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AudioSettingsPanel" Margin="0,0,12,0">
      <TextBlock Text="Audio" Style="{StaticResource SettingsHeading}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><CheckBox x:Name="AudioCheck" Content="Record speaker output"/>
        <TextBlock Text="Headphones / speakers" Style="{StaticResource Caption}" Margin="0,8,0,7"/>
        <DockPanel><Button x:Name="SpeakerLockButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="34" FontSize="13" Content="&#xE785;" Click="AudioLock_Click" Margin="6,0,0,0" VerticalAlignment="Center"/><ComboBox x:Name="AudioDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="Choose the output used by your game and Discord"/></DockPanel>
        <TextBlock Text="Recording mixer" Style="{StaticResource Caption}" Margin="0,14,0,4"/>
        <DockPanel Margin="0,0,0,2"><TextBlock x:Name="DesktopVolumeLabel" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}" FontSize="12" Width="38" TextAlignment="Right" VerticalAlignment="Center"/><TextBlock Text="All desktop audio" DockPanel.Dock="Left" Width="110" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
         <Slider x:Name="DesktopVolumeSlider" Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25" IsMoveToPointEnabled="True" ValueChanged="Volume_Changed" AutomationProperties.Name="All desktop audio recording level" Height="30"/></DockPanel>
        <Button x:Name="AppMixToggle" Click="AppMixToggle_Click" HorizontalAlignment="Left" Background="Transparent" BorderBrush="Transparent" MinHeight="26" Padding="0,2" FontSize="12" Foreground="{DynamicResource Muted}" AutomationProperties.Name="Show per-app levels"/>
        <StackPanel x:Name="AppMixRows" Visibility="Collapsed" Margin="2,0,0,0"/>
        <TextBlock x:Name="AppMixNote" Visibility="Collapsed" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Text="Levels only change your recordings. Apps playing sound appear here; any app not at 100% is recorded on its own, and Windows system sounds are then left out."/>
       </StackPanel>
       <StackPanel Grid.Column="2"><CheckBox x:Name="MicrophoneCheck" Content="Record microphone"/>
        <TextBlock Text="Microphone input" Style="{StaticResource Caption}" Margin="0,8,0,7"/>
        <DockPanel><Button x:Name="MicrophoneLockButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="34" FontSize="13" Content="&#xE785;" Click="AudioLock_Click" Margin="6,0,0,0" VerticalAlignment="Center"/><ComboBox x:Name="MicrophoneDeviceBox" DisplayMemberPath="Name" SelectedValuePath="Id" ToolTip="Choose the microphone for your voice"/></DockPanel>
        <DockPanel Margin="0,14,0,0"><TextBlock x:Name="MicrophoneVolumeLabel" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}" FontSize="12"/><TextBlock Text="Recording volume" Style="{StaticResource Caption}"/></DockPanel>
        <Slider x:Name="MicrophoneVolumeSlider" Minimum="0" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="25" IsMoveToPointEnabled="True" ValueChanged="Volume_Changed" AutomationProperties.Name="Microphone recording volume" Height="36"/>
        <TextBlock Text="Noise suppression" Style="{StaticResource Caption}" Margin="0,8,0,7"/>
        <ComboBox x:Name="MicNoiseBox" HorizontalAlignment="Left" MinWidth="220" AutomationProperties.Name="Microphone noise suppression" ToolTip="Removes steady noise like fans, hum and hiss from your microphone while recording. Uses about 1% of one CPU core."><ComboBoxItem Content="Off" Tag="Off"/><ComboBoxItem Content="Light · fans and hiss" Tag="Light"/><ComboBoxItem Content="Strong · louder rooms" Tag="Strong"/></ComboBox>
       </StackPanel>
      </Grid>
      <TextBlock Text="Audio quality" Style="{StaticResource Caption}" Margin="0,14,0,7"/>
      <ComboBox x:Name="AudioBitrateBox" HorizontalAlignment="Left" MinWidth="220"/>
      <CheckBox x:Name="SeparateTracksCheck" Content="Keep desktop and microphone on separate tracks" Margin="0,12,0,0" ToolTip="Clips keep a combined track for players and Discord, plus desktop and microphone tracks you can adjust in the trimmer."/>
      <TextBlock Text="Choose the headphones you listen through. Their audio is captured across apps, tabs and screens. Microphone adds your voice; both sources share one track. Volume only changes your recordings, not what you hear." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,14,0,6"/>
      <TextBlock Text="Use the lock beside the speaker or microphone icon to keep a device no matter what. Flashback won't switch when Windows does, and if the device disconnects, recording continues with silence for it until it's back." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,0,0,10"/>
      <Button Content="Refresh audio devices" Click="RefreshAudio_Click" HorizontalAlignment="Left"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem x:Name="HotkeySettings" Header="Hotkeys" Style="{StaticResource SideTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
      <TextBlock Text="Recording" Style="{StaticResource SettingsHeading}"/>
      <DockPanel Margin="0,0,0,6"><TextBox x:Name="HotkeyBox" DockPanel.Dock="Right" Style="{StaticResource ShortcutBox}" GotKeyboardFocus="Hotkey_GotFocus" LostKeyboardFocus="Hotkey_LostFocus" PreviewKeyDown="Hotkey_KeyDown" AutomationProperties.Name="Save replay shortcut"/><TextBlock Text="Save replay" VerticalAlignment="Center"/></DockPanel>
      <DockPanel Margin="0,0,0,6"><TextBox x:Name="PauseHotkeyBox" DockPanel.Dock="Right" Style="{StaticResource ShortcutBox}" GotKeyboardFocus="Hotkey_GotFocus" LostKeyboardFocus="Hotkey_LostFocus" PreviewKeyDown="Hotkey_KeyDown" AutomationProperties.Name="Start or pause recording shortcut"/><TextBlock Text="Start / pause recording" VerticalAlignment="Center"/></DockPanel>
      <TextBlock Text="These work everywhere, including in games." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,22"/>
      <DockPanel Margin="0,0,0,14"><Button Content="Reset trimmer keys" Click="ResetTrimKeys_Click" DockPanel.Dock="Right" FontSize="12" Padding="10,6" MinHeight="32"/><TextBlock Text="Trimmer" Style="{StaticResource SettingsHeading}" Margin="0" VerticalAlignment="Center"/></DockPanel>
      <StackPanel x:Name="TrimShortcutRows"/>
      <TextBlock Text="Click a field and press a key. Modifiers are optional; Escape cancels. Trimmer keys only work while the trimmer is focused." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,12"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Notifications" Style="{StaticResource SideTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
      <TextBlock Text="Notifications" Style="{StaticResource SettingsHeading}"/>
      <CheckBox x:Name="OverlayCheck" Content="Show clip requested, saved and error banners"/>
      <Grid Margin="0,12,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Overlay corner" Style="{StaticResource Caption}"/><ComboBox x:Name="OverlayCornerBox"/></StackPanel>
       <StackPanel Grid.Column="2"><TextBlock Text="Show result for" Style="{StaticResource Caption}"/><ComboBox x:Name="OverlayDurationBox"/></StackPanel>
      </Grid>
      <Button Content="Preview overlay" Click="PreviewOverlay_Click" HorizontalAlignment="Left"/>
      <CheckBox x:Name="NotifyCheck" Content="Also show Windows notifications for saved clips" Margin="0,14,0,7"/>
      <TextBlock Text="Overlays work best in borderless or windowed games." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem x:Name="AppearanceSettings" Header="Appearance" Style="{StaticResource SideTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
      <TextBlock Text="Appearance" Style="{StaticResource SettingsHeading}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Dark palette" Style="{StaticResource Caption}"/><ComboBox x:Name="PaletteBox" SelectionChanged="Appearance_Changed"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Accent color" Style="{StaticResource Caption}"/><ComboBox x:Name="AccentBox" SelectionChanged="Appearance_Changed"/></StackPanel></Grid>
      <TextBlock Text="Applies immediately. Recording keeps running." Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem x:Name="PerformanceSettings" Header="Performance" Style="{StaticResource SideTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
      <TextBlock Text="Performance" Style="{StaticResource SettingsHeading}"/>
      <TextBlock Text="Flashback is light by default. On an older or busy PC, these help it stay out of your game's way." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
      <CheckBox x:Name="LighterModeCheck" Content="Lighter mode" Click="LighterMode_Click" ToolTip="Turns off every extra below in one go"/>
      <TextBlock Text="Turns off thumbnails, waveforms, preview effects and animations in one go. Exports and recordings look the same." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6"/>
      <TextBlock Text="Recording" Style="{StaticResource Caption}" Margin="0,16,0,4"/>
      <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Text="Recording is the biggest cost, and it's set under Video. On a weaker PC we recommend 720p at 30 FPS: it uses about half the CPU of 1080p 60 (about 11% of one core instead of 23% in our tests)."/>
      <TextBlock Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Text="The per-app audio mixer and microphone noise suppression each add about another 10% of a core, so leave them off if you don't need them."/>
      <Button x:Name="RecommendedVideoButton" Content="Use 720p 30 FPS" Click="RecommendedVideo_Click" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Sets Video to 720p at 30 FPS. Click Apply settings to use it."/>
      <TextBlock Text="Editing and browsing" Style="{StaticResource Caption}" Margin="0,18,0,4"/>
      <CheckBox x:Name="ThumbnailsCheck" Content="Clip thumbnails on the Clips page" Click="PerformanceToggle_Click" ToolTip="Off: clips are listed without preview pictures, which saves reading every video file"/>
      <CheckBox x:Name="WaveformsCheck" Content="Audio waveforms in the trimmer" Click="PerformanceToggle_Click" ToolTip="Off: the audio lanes still work, without reading the whole soundtrack to draw them"/>
      <CheckBox x:Name="PreviewEffectsCheck" Content="Shadows and animations in the trimmer preview" Click="PerformanceToggle_Click" ToolTip="Off: text and pictures show without shadows or entrance animations while editing. Exports still include them."/>
      <CheckBox x:Name="AnimationsCheck" Content="Interface animations" Click="PerformanceToggle_Click" ToolTip="The pulsing record light, sliding audio lanes and similar touches"/>
      <TextBlock Text="Exports" Style="{StaticResource Caption}" Margin="0,18,0,4"/>
      <CheckBox x:Name="GpuExportCheck" Content="GPU-accelerated export" ToolTip="Decodes your clip on the graphics card while exporting. Turn off if exports fail or look wrong."/>
      <TextBlock Text="Exports decode on the graphics card: about 3.5× faster and a third of the CPU, even while a game is running." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,6"/>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Storage" Style="{StaticResource SideTab}"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,12,0">
      <TextBlock Text="Storage and startup" Style="{StaticResource SettingsHeading}"/>
      <TextBlock Text="Clips folder" Style="{StaticResource Caption}"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="FolderBox"/><Button Grid.Column="2" Content="Browse…" Click="Browse_Click"/></Grid>
      <TextBlock Text="Game folder override (optional)" Style="{StaticResource Caption}" Margin="0,16,0,7"/><TextBox x:Name="GameBox"/>
      <TextBlock Text="Leave blank to sort by the foreground game / app. Example: Rainbow Six Siege / Rainbow Six Siege — 2026-09-12_21-34-08-125 — 60s.mp4" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,13"/>
      <CheckBox x:Name="LaunchCheck" Content="Launch in the tray when I sign into Windows"/>
      <CheckBox x:Name="AutoBufferCheck" Content="Start the replay buffer when Flashback launches"/>
      <CheckBox x:Name="AutoGameCheck" Content="Start recording when a game opens, and stop after it closes"/>
      <TextBlock Text="External editor" Style="{StaticResource Caption}" Margin="0,18,0,7"/>
      <TextBlock x:Name="EditorLabel" Foreground="{DynamicResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"/><Button Content="Choose app…" Click="ChooseEditor_Click" HorizontalAlignment="Left" Margin="0,0,0,12"/>      <TextBlock Text="Updates" Style="{StaticResource Caption}" Margin="0,18,0,0"/>
      <CheckBox x:Name="UpdateCheck" Content="Check for updates when Flashback starts"/>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,12"><Button x:Name="CheckUpdatesButton" Content="Check now" Click="CheckUpdates_Click"/><TextBlock x:Name="UpdateStatusLabel" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/></StackPanel>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <StackPanel Grid.Row="1" Margin="174,12,0,0">
     <Button x:Name="ApplyButton" Content="Apply settings" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/>
     <TextBlock Text="Hotkey and overlay changes keep your buffer. Recording or output-folder changes restart it." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel></Grid>
   </TabItem>

