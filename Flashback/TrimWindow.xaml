<Window x:Class="Flashback.TrimWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Flashback" AllowDrop="True" PreviewDragOver="Video_DragOver" PreviewDrop="Video_Drop" PreviewKeyDown="Trim_KeyDown" Title="Trim clip · Flashback" Width="1120" Height="940" MinWidth="880" MinHeight="740" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style x:Key="TrimButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="11"/></Style>
 </Window.Resources>
 <DockPanel Background="{DynamicResource AppBackground}"><Menu x:Name="EditorMenu" DockPanel.Dock="Top" Background="Transparent" Foreground="{DynamicResource Ink}" Margin="14,6" FontSize="12"><MenuItem Header="_File"><MenuItem x:Name="OpenVideoMenu" Header="_Open video…" Click="OpenVideo_Click"/><MenuItem x:Name="RecentMenu" Header="Recent videos" SubmenuOpened="RecentMenu_Opened"/><Separator/><MenuItem Header="Open trim project…" Click="OpenProject_Click"/><MenuItem x:Name="SaveProjectMenu" Header="Save trim project" Click="SaveProject_Click"/><MenuItem Header="Save trim project as…" Click="SaveProjectAs_Click"/><MenuItem x:Name="AutoSaveProject" Header="Autosave named projects" IsCheckable="True" IsChecked="True"/><Separator/><MenuItem x:Name="ExportMenu" Header="Export selected sections…" Click="Export_Click"/><MenuItem x:Name="SnapshotMenu" Header="Save snapshot…" Click="Snapshot_Click"/></MenuItem><MenuItem Header="_Edit"><MenuItem x:Name="UndoMenu" Header="Undo" Click="Undo_Click"/><MenuItem x:Name="RedoMenu" Header="Redo" Click="Redo_Click"/><Separator/><MenuItem x:Name="AddSectionMenu" Header="Add marked section" Click="Add_Click"/><MenuItem x:Name="SplitMenu" Header="Split section at playhead" Click="Split_Click"/><MenuItem x:Name="RemoveMenu" Header="Remove selected section" Click="Remove_Click"/></MenuItem><MenuItem Header="_View"><MenuItem x:Name="ZoomInMenu" Header="Zoom in" Click="ZoomIn_Click"/><MenuItem x:Name="ZoomOutMenu" Header="Zoom out" Click="ZoomOut_Click"/><MenuItem Header="Fit timeline" Click="ZoomFit_Click"/><MenuItem x:Name="GoToTimeMenu" Header="Go to time…" Click="Timecode_Click"/></MenuItem><MenuItem Header="_Help"><MenuItem x:Name="ShortcutGuideMenu" Header="Keyboard and mouse shortcuts" Click="ShortcutGuide_Click"/></MenuItem></Menu><Grid><Grid x:Name="TrimContent" Visibility="Collapsed" Margin="16,6,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,8"><TextBlock x:Name="SourceLabel" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></Grid>
  <Border x:Name="PreviewFrame" Grid.Row="1" Background="#000000" CornerRadius="8" ClipToBounds="True"><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform" MediaOpened="Player_Opened" MediaEnded="Player_Ended" MediaFailed="Player_Failed"/></Border>
  <StackPanel Grid.Row="2" Margin="0,8,0,0">
   <Grid Height="30"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="TimelineZoomLabel" FontSize="11" VerticalAlignment="Center" MinWidth="142"/>
    <local:TimelineOverview x:Name="TimelineMap" Grid.Column="1" Margin="12,0,20,0" Height="28" AutomationProperties.Name="Full clip overview"/>
    <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Style="{StaticResource TrimButton}" Content="−" Width="30" Height="28" MinHeight="28" Padding="0" Click="ZoomOut_Click" ToolTip="Zoom timeline out · Ctrl+↓" AutomationProperties.Name="Zoom timeline out"/><Button Style="{StaticResource TrimButton}" Content="+" Width="30" Height="28" MinHeight="28" Padding="0" Margin="4,0" Click="ZoomIn_Click" ToolTip="Zoom timeline in · Ctrl+↑" AutomationProperties.Name="Zoom timeline in"/><Button x:Name="TimelineFitButton" Style="{StaticResource TrimButton}" Content="Fit" Height="28" MinHeight="28" Padding="10,0" Click="ZoomFit_Click" ToolTip="Show the entire clip in the timeline"/></StackPanel>
   </Grid>
   <local:TrimTimeline x:Name="Timeline" Height="80" AutomationProperties.Name="Clip timeline" ToolTip="Click to seek; drag the edges to trim. Arrows: frame · Shift: 0.5 s · Ctrl: 1 s · Wheel: pan · Ctrl+wheel: zoom"/>
  </StackPanel>
  <Grid Grid.Row="3" Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <TextBlock x:Name="PositionLabel" VerticalAlignment="Center" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource Muted}"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Button Style="{StaticResource TrimButton}" x:Name="MarkStartButton" Click="MarkStart_Click" Background="#203D33" BorderBrush="#427B64" ToolTip="Set start at playhead · I" AutomationProperties.Name="Set start, shortcut I"><StackPanel Orientation="Horizontal"><TextBlock Text="☛" FontFamily="Segoe UI Symbol" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Start" Foreground="#D3F5E4" VerticalAlignment="Center"/><Border Background="#142C23" BorderBrush="#57866F" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="MarkStartKey" Text="I" FontFamily="Consolas" FontSize="10" Foreground="#B0F2D2"/></Border></StackPanel></Button>
    <Button Style="{StaticResource TrimButton}" x:Name="PlayToggle" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="44" Margin="8,0" ToolTip="Play / pause · Space" AutomationProperties.Name="Play or pause clip" Click="Play_Click"/>
    <Button Style="{StaticResource TrimButton}" x:Name="MarkEndButton" Click="MarkEnd_Click" Background="#443122" BorderBrush="#886340" ToolTip="Set end at playhead · O" AutomationProperties.Name="Set end, shortcut O"><StackPanel Orientation="Horizontal"><TextBlock Text="☚" FontFamily="Segoe UI Symbol" FontSize="18" Foreground="#F3BF84" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="End" Foreground="#FFE2C1" VerticalAlignment="Center"/><Border Background="#302113" BorderBrush="#956D46" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="MarkEndKey" Text="O" FontFamily="Consolas" FontSize="10" Foreground="#FFD49F"/></Border></StackPanel></Button>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
    <StackPanel x:Name="ListControls" Orientation="Horizontal">
     <Button Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="32" FontSize="14" Content="&#xE8C6;" Click="Split_Click" ToolTip="Split section at playhead" AutomationProperties.Name="Split section"/>
     <Button Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="32" FontSize="14" Content="&#xE74D;" Click="Remove_Click" ToolTip="Remove selected section" AutomationProperties.Name="Remove section"/>
     <Button Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="32" FontSize="14" Content="&#xE7A7;" Click="Undo_Click" ToolTip="Undo" AutomationProperties.Name="Undo"/>
     <Button Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="32" FontSize="14" Content="&#xE894;" Click="Clear_Click" ToolTip="Clear all kept sections" AutomationProperties.Name="Clear sections"/>
    </StackPanel>
    <Button Style="{StaticResource IconButton}" Width="32" Height="32" MinHeight="32" FontSize="13" Content="&#xE768;" Click="Preview_Click" ToolTip="Preview only the kept sections" AutomationProperties.Name="Preview sections" Foreground="{DynamicResource Accent}" Margin="6,0,0,0"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="RangeControls" Grid.Row="4" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Border Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
    <TextBox x:Name="StartBox" Width="112" Height="32" Text="0:00.000" TextChanged="RangeText_Changed" AutomationProperties.Name="Section start" FontSize="12" Padding="7,4" FontFamily="Consolas"/>
    <TextBlock Text="→" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0"/>
    <Border Width="3" Height="16" CornerRadius="2" Background="#F3BF84" Margin="0,0,6,0" VerticalAlignment="Center"/>
    <TextBox x:Name="EndBox" Width="112" Height="32" TextChanged="RangeText_Changed" AutomationProperties.Name="Section end" FontSize="12" Padding="7,4" FontFamily="Consolas"/>
    <Button Style="{StaticResource TrimButton}" x:Name="AddSectionButton" Content="Add section  +" Click="Add_Click" Margin="10,0,0,0" BorderBrush="{DynamicResource Accent}" FontSize="12"/>
    <Button Style="{StaticResource TrimButton}" Content="Update" Click="Update_Click" Margin="4,0,12,0" Background="Transparent" BorderBrush="Transparent" FontSize="12" ToolTip="Replace the selected section with this selection"/>
   </StackPanel>
   <DockPanel x:Name="SectionsRow" Grid.Column="1" Visibility="Collapsed">
    <ListBox x:Name="SectionsList" Height="34" DisplayMemberPath="CompactLabel" SelectionChanged="Section_Selected" BorderThickness="0" VerticalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled" ToolTip="Kept sections"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="9,4"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/></Style></ListBox.ItemContainerStyle></ListBox>
   </DockPanel>
  </Grid>
  <Border Grid.Row="6" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TotalLabel" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="StatusLabel" Text="Drag the edges to trim. Add sections to remove gaps." Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="ExportOptionsButton" Style="{StaticResource TrimButton}" Click="ExportOptions_Click" Background="Transparent" BorderBrush="Transparent" FontSize="12" Margin="0,0,6,0" ToolTip="Cut, format and size options"><StackPanel Orientation="Horizontal"><TextBlock Text="Options" VerticalAlignment="Center"/><TextBlock x:Name="ExportOptionsChevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="7,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></StackPanel></Button><Button Style="{StaticResource TrimButton}" x:Name="CancelExportButton" Content="Cancel" Click="CancelExport_Click" Visibility="Collapsed" Margin="0,0,8,0"/><Button x:Name="ExportButton" Content="Export clip…" MinHeight="36" Padding="16,6" FontSize="13" Style="{StaticResource PrimaryButton}" Click="Export_Click"/></StackPanel>
   <StackPanel x:Name="ExportOptionsPanel" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" Margin="0,10,0,0">
    <WrapPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,18,6"><TextBlock Text="Cut" Style="{StaticResource Caption}" Margin="0,0,8,0" VerticalAlignment="Center"/><ComboBox x:Name="ExportMode" Width="160" SelectedIndex="1" SelectionChanged="ExportMode_Changed" MinHeight="36" AutomationProperties.Name="Cut precision"><ComboBoxItem Content="Precise cut"/><ComboBoxItem Content="Rough cut · fast"/></ComboBox></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,18,6"><TextBlock Text="Format" Style="{StaticResource Caption}" Margin="0,0,8,0" VerticalAlignment="Center"/><ComboBox x:Name="SharePreset" Width="190" MinHeight="36" SelectedIndex="0" SelectionChanged="Share_Changed" AutomationProperties.Name="Export preset"><ComboBoxItem Content="Standard export"/><ComboBoxItem Content="Share · 1080p / 60"/><ComboBoxItem Content="Compact · 720p / 30"/></ComboBox></StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,0,18,6"><TextBlock Text="Size limit, MB" Style="{StaticResource Caption}" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBox x:Name="SizeLimit" Width="80" Height="36" Text="0" ToolTip="0 = no limit. MB uses 1,000,000 bytes; enter your upload limit." TextChanged="SizeLimit_Changed"/></StackPanel>
     <CheckBox x:Name="WaitForRecording" Content="Wait until recording pauses" IsChecked="True" VerticalAlignment="Center" Margin="0,0,0,6" FontSize="12" ToolTip="Defers video encoding so it does not compete with the game. Rough exports do not need to wait."/>
    </WrapPanel>
    <TextBlock x:Name="ModeHint" Text="Fast export; edges may extend to nearby keyframes." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
   </StackPanel>
   <ProgressBar x:Name="ExportProgress" Grid.Row="2" Grid.ColumnSpan="2" Minimum="0" Maximum="1" Height="3" Margin="0,8,0,0" Background="#303A42" Foreground="{DynamicResource Accent}"/>
  </Grid></Border>
 </Grid>
 <Grid x:Name="EmptyState" Margin="32"><Border BorderBrush="#46515D" BorderThickness="1" CornerRadius="14" Background="{DynamicResource Surface}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"><TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="Drop a video to trim" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,8"/><TextBlock Text="MP4 · M4V · MOV" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/><Button Content="Open video…" Click="OpenVideo_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,22,0,0"/><TextBlock x:Name="ImportStatus" Text="Your original stays unchanged." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="20,18,20,0"/></StackPanel></Border></Grid>
 </Grid>
</DockPanel></Window>







