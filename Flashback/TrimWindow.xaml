<Window x:Class="Flashback.TrimWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Flashback" AllowDrop="True" PreviewDragOver="Video_DragOver" PreviewDrop="Video_Drop" PreviewKeyDown="Trim_KeyDown" Title="Trim clip · Flashback" Width="1120" Height="940" MinWidth="880" MinHeight="740" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <local:PlusOneConverter x:Key="PlusOne"/>
  <Style x:Key="TrimButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinHeight" Value="32"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="11"/></Style>
 </Window.Resources>
 <DockPanel Background="{DynamicResource AppBackground}"><Menu x:Name="EditorMenu" DockPanel.Dock="Top" Background="Transparent" Foreground="{DynamicResource Ink}" Margin="14,6" FontSize="12"><MenuItem Header="_File"><MenuItem x:Name="OpenVideoMenu" Header="_Open video…" Click="OpenVideo_Click"/><MenuItem x:Name="RecentMenu" Header="Recent videos" SubmenuOpened="RecentMenu_Opened"/><Separator/><MenuItem Header="Open trim project…" Click="OpenProject_Click"/><MenuItem x:Name="SaveProjectMenu" Header="Save trim project" Click="SaveProject_Click"/><MenuItem Header="Save trim project as…" Click="SaveProjectAs_Click"/><MenuItem x:Name="AutoSaveProject" Header="Autosave named projects" IsCheckable="True" IsChecked="True"/><Separator/><MenuItem x:Name="ExportMenu" Header="Export selected sections…" Click="Export_Click"/><MenuItem x:Name="SnapshotMenu" Header="Save snapshot…" Click="Snapshot_Click"/></MenuItem><MenuItem Header="_Edit"><MenuItem x:Name="UndoMenu" Header="Undo" Click="Undo_Click"/><MenuItem x:Name="RedoMenu" Header="Redo" Click="Redo_Click"/><Separator/><MenuItem x:Name="AddSectionMenu" Header="Add marked section" Click="Add_Click"/><MenuItem x:Name="SplitMenu" Header="Split section at playhead" Click="Split_Click"/><MenuItem x:Name="RemoveMenu" Header="Remove selected section" Click="Remove_Click"/></MenuItem><MenuItem Header="_View"><MenuItem x:Name="ZoomInMenu" Header="Zoom in" Click="ZoomIn_Click"/><MenuItem x:Name="ZoomOutMenu" Header="Zoom out" Click="ZoomOut_Click"/><MenuItem Header="Fit timeline" Click="ZoomFit_Click"/><MenuItem x:Name="GoToTimeMenu" Header="Go to time…" Click="Timecode_Click"/></MenuItem><MenuItem Header="_Help"><MenuItem x:Name="ShortcutGuideMenu" Header="Keyboard and mouse shortcuts" Click="ShortcutGuide_Click"/></MenuItem></Menu><Grid><Grid x:Name="TrimContent" Visibility="Collapsed" Margin="16,6,16,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,8"><TextBlock x:Name="SourceLabel" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/></Grid>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Border x:Name="PreviewFrame" Background="#000000" CornerRadius="8" ClipToBounds="True"><MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Close" ScrubbingEnabled="True" Stretch="Uniform" MediaOpened="Player_Opened" MediaEnded="Player_Ended" MediaFailed="Player_Failed"/></Border>
   <Border x:Name="CensorOverlay" Background="#000000" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock Text="Blacked out in the export" Foreground="#9DA6B1" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   <local:OverlayLayer x:Name="OverlayView" AutomationProperties.Name="Text and pictures"/>
   <local:CropOverlay x:Name="CropArea" Visibility="Collapsed" AutomationProperties.Name="Crop area"/>
   <local:ZoomTargetOverlay x:Name="ZoomTarget" Visibility="Collapsed" AutomationProperties.Name="Zoom target"/>
   <Border x:Name="ZoomPanel" Grid.Column="1" Width="300" Margin="10,0,0,0" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="8" Padding="12,10">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top">
      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" FontSize="10" Content="&#xE711;" Click="ZoomDone_Click" ToolTip="Done editing this zoom" AutomationProperties.Name="Close zoom editor"/>
      <TextBlock Text="Zoom" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock x:Name="ZoomTitle" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
     </DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,10,0,0">
      <Button x:Name="ZoomDeletePreset" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" MinHeight="28" FontSize="11" Content="&#xE74D;" Click="ZoomDeletePreset_Click" ToolTip="Delete this saved preset" Margin="4,0,0,0" AutomationProperties.Name="Delete preset"/>
      <Button DockPanel.Dock="Right" Style="{StaticResource TrimButton}" Content="Save…" Click="ZoomSavePreset_Click" Margin="6,0,0,0" MinHeight="28" Height="28" ToolTip="Save this curve and max zoom as a preset"/>
      <ComboBox x:Name="ZoomPresetBox" MinHeight="28" SelectionChanged="ZoomPreset_Changed" AutomationProperties.Name="Zoom preset"/>
     </DockPanel>
     <StackPanel x:Name="ZoomCurveTabs" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
      <Button x:Name="ZoomInTab" Style="{StaticResource TrimButton}" Content="Zoom in" Click="ZoomTab_Click" MinHeight="26" Height="26" FontSize="11"/>
      <Button x:Name="ZoomOutTab" Style="{StaticResource TrimButton}" Content="Zoom out" Click="ZoomTab_Click" MinHeight="26" Height="26" FontSize="11" Margin="4,0,0,0"/>
     </StackPanel>
     <local:ZoomCurveEditor x:Name="ZoomGraph" DockPanel.Dock="Top" Height="180" Margin="0,8,0,0" AutomationProperties.Name="Zoom curve"/>
     <TextBlock x:Name="ZoomReadout" DockPanel.Dock="Top" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,4,0,0"/>
     <CheckBox x:Name="ZoomOutCheck" DockPanel.Dock="Top" Content="Zoom back out at the end" Margin="0,10,0,0" Click="ZoomOutToggle_Click"/>
     <CheckBox x:Name="ZoomOutSameCheck" DockPanel.Dock="Top" Content="Same curve as zoom in" Margin="22,6,0,0" IsChecked="True" Click="ZoomOutToggle_Click" Visibility="Collapsed"/>
     <Button DockPanel.Dock="Bottom" Style="{StaticResource TrimButton}" Content="Remove zoom" Click="ZoomRemove_Click" Background="Transparent" BorderBrush="Transparent" FontSize="11" HorizontalAlignment="Left" Margin="-8,0,0,0"/>
     <TextBlock Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,6" Text="Drag the box on the video to aim; drag its corners to zoom further. On the graph, drag points; Ctrl-drag scales the height, Alt-drag the timing. Double-click adds a point, right-click removes one."/>
    </DockPanel>
   </Border>
   <Border x:Name="OverlayPanel" Grid.Column="1" Width="300" Margin="10,0,0,0" Visibility="Collapsed" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="8" Padding="12,10,4,10">
    <DockPanel>
     <DockPanel DockPanel.Dock="Top" Margin="0,0,8,0">
      <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="26" Height="26" MinHeight="26" FontSize="10" Content="&#xE711;" Click="OverlayDone_Click" ToolTip="Done editing" AutomationProperties.Name="Close text and picture editor"/>
      <TextBlock x:Name="OverlayHeading" Text="Text" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <TextBlock x:Name="OverlayTitle" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
     </DockPanel>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0" Padding="0,0,8,0">
      <StackPanel x:Name="OverlayControls"/>
     </ScrollViewer>
    </DockPanel>
   </Border>
   <Border x:Name="CropBar" Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,10,0,0" Background="#E6111318" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="8" Padding="4">
    <StackPanel Orientation="Horizontal">
     <Button Style="{StaticResource TrimButton}" Content="Free" Tag="0" Click="CropAspect_Click" Background="Transparent" BorderBrush="Transparent"/>
     <Button Style="{StaticResource TrimButton}" Content="16:9" Tag="1.7777778" Click="CropAspect_Click" Background="Transparent" BorderBrush="Transparent"/>
     <Button Style="{StaticResource TrimButton}" Content="9:16" Tag="0.5625" Click="CropAspect_Click" Background="Transparent" BorderBrush="Transparent"/>
     <Button Style="{StaticResource TrimButton}" Content="1:1" Tag="1" Click="CropAspect_Click" Background="Transparent" BorderBrush="Transparent"/>
     <Button Style="{StaticResource TrimButton}" Content="4:3" Tag="1.3333333" Click="CropAspect_Click" Background="Transparent" BorderBrush="Transparent"/>
     <Button Style="{StaticResource TrimButton}" Content="Remove crop" Click="CropReset_Click" Background="Transparent" BorderBrush="Transparent" Margin="8,0,0,0"/>
     <Button Style="{StaticResource TrimButton}" Content="Done" Click="CropDone_Click" BorderBrush="{DynamicResource Accent}" Margin="4,0,0,0"/>
    </StackPanel>
   </Border>
  </Grid>
  <local:TrimTimeline x:Name="Timeline" Grid.Row="2" Margin="0,8,0,0" AutomationProperties.Name="Clip timeline"/>
  <Grid Grid.Row="3" Margin="0,4,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="PositionButton" Style="{StaticResource IconButton}" Width="Auto" Height="28" MinHeight="28" Padding="6,0" Margin="-6,0,0,0" Click="Position_Click" ToolTip="Type exact start and end times" AutomationProperties.Name="Show time fields"><TextBlock x:Name="PositionLabel" VerticalAlignment="Center" FontSize="12" FontFamily="Consolas" Foreground="{DynamicResource Muted}"/></Button>
    <Button x:Name="TimelineFitButton" Style="{StaticResource IconButton}" Width="Auto" MinWidth="34" Height="28" MinHeight="28" Padding="6,0" Margin="4,0,0,0" Click="ZoomFit_Click" ToolTip="Timeline zoom · scroll over the timeline to zoom, click here to fit the whole clip" AutomationProperties.Name="Fit timeline"><TextBlock x:Name="TimelineZoomLabel" FontFamily="Segoe UI" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></Button>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal">
    <Border Width="60"/><!-- balances the speed button so Play stays centered -->
    <Button Style="{StaticResource TrimButton}" x:Name="MarkStartButton" Click="MarkStart_Click" Background="#203D33" BorderBrush="#427B64" ToolTip="Set start at playhead · I" AutomationProperties.Name="Set start, shortcut I"><StackPanel Orientation="Horizontal"><TextBlock Text="☛" FontFamily="Segoe UI Symbol" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="Start" Foreground="#D3F5E4" VerticalAlignment="Center"/><Border Background="#142C23" BorderBrush="#57866F" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="MarkStartKey" Text="I" FontFamily="Consolas" FontSize="10" Foreground="#B0F2D2"/></Border></StackPanel></Button>
    <Button Style="{StaticResource TrimButton}" x:Name="PlayToggle" Content="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="15" Width="44" Margin="8,0" ToolTip="Play / pause · Space" AutomationProperties.Name="Play or pause clip" Click="Play_Click"/>
    <Button Style="{StaticResource TrimButton}" x:Name="MarkEndButton" Click="MarkEnd_Click" Background="#443122" BorderBrush="#886340" ToolTip="Set end at playhead · O" AutomationProperties.Name="Set end, shortcut O"><StackPanel Orientation="Horizontal"><TextBlock Text="☚" FontFamily="Segoe UI Symbol" FontSize="18" Foreground="#F3BF84" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBlock Text="End" Foreground="#FFE2C1" VerticalAlignment="Center"/><Border Background="#302113" BorderBrush="#956D46" BorderThickness="1" CornerRadius="3" Padding="4,0" Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="MarkEndKey" Text="O" FontFamily="Consolas" FontSize="10" Foreground="#FFD49F"/></Border></StackPanel></Button>
    <Button x:Name="SpeedButton" Style="{StaticResource TrimButton}" Content="1×" Width="52" Margin="8,0,0,0" FontSize="12" Background="Transparent" Click="Speed_Click" ToolTip="Preview speed · Ctrl+wheel over the timeline" AutomationProperties.Name="Preview speed"/>
    <Popup x:Name="SpeedPopup" PlacementTarget="{Binding ElementName=SpeedButton}" Placement="Top" StaysOpen="False" Closed="SpeedPopup_Closed" AllowsTransparency="True" VerticalOffset="-6">
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="8" Padding="14,12" Width="280">
      <StackPanel>
       <DockPanel><TextBlock x:Name="SpeedLabel" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}" FontSize="12"/><TextBlock Text="Preview speed" FontSize="13" FontWeight="SemiBold"/></DockPanel>
       <Slider x:Name="SpeedSlider" Minimum="-2.302585" Maximum="1.386294" Value="0" SmallChange="0.05" LargeChange="0.3" IsMoveToPointEnabled="True" Margin="0,10,0,6" ValueChanged="SpeedSlider_Changed" AutomationProperties.Name="Preview speed"/>
       <UniformGrid x:Name="SpeedPresets" Rows="1" Margin="0,0,0,6"/>
       <TextBlock Text="Changes playback here only; exports keep normal speed." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
      </StackPanel>
     </Border>
    </Popup>
   </StackPanel>
   <!-- Tools sit in a compact two-row block: timeline tools on top, section editing below. -->
   <Border Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
    <StackPanel x:Name="ListControls">
     <StackPanel Orientation="Horizontal">
      <Button x:Name="CutToolButton" Style="{StaticResource IconButton}" Width="30" Height="26" MinHeight="26" FontSize="13" Content="&#xE75C;" Click="CutTool_Click" ToolTip="Cut out: black out video or mute audio for part of the clip without removing time · X" AutomationProperties.Name="Cut out tool"/>
      <Button x:Name="SlowToolButton" Style="{StaticResource IconButton}" Width="30" Height="26" MinHeight="26" FontSize="13" Content="&#xE916;" Click="SlowTool_Click" ToolTip="Speed: click two spots to slow down or speed up that part · R" AutomationProperties.Name="Slow motion tool"/>
      <Popup x:Name="SlowPopup" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True" Closed="SlowPopup_Closed">
       <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="8" Padding="10">
        <StackPanel>
         <DockPanel Margin="2,0,2,4"><TextBlock x:Name="RegionSpeedLabel" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}" FontSize="12"/><TextBlock Text="Speed" FontSize="12" FontWeight="SemiBold"/></DockPanel>
         <Slider x:Name="RegionSpeedSlider" Width="260" Minimum="-2.302585" Maximum="1.386294" SmallChange="0.05" LargeChange="0.3" IsMoveToPointEnabled="True" Margin="0,4,0,6" ValueChanged="RegionSpeed_Changed" PreviewMouseLeftButtonDown="RegionSpeedSlider_Grab" AutomationProperties.Name="Speed of this part"/>
         <UniformGrid x:Name="SlowChoices" Rows="1"/>
         <Button Style="{StaticResource TrimButton}" Content="Remove speed change" Click="SlowRemove_Click" Background="Transparent" BorderBrush="Transparent" FontSize="11" MinHeight="26" Height="26" Margin="0,6,0,0" HorizontalAlignment="Stretch"/>
        </StackPanel>
       </Border>
      </Popup>
      <Button x:Name="ZoomToolButton" Style="{StaticResource IconButton}" Width="30" Height="26" MinHeight="26" FontSize="13" Content="&#xE71E;" Click="ZoomTool_Click" ToolTip="Zoom: click two spots to zoom in on that part" AutomationProperties.Name="Zoom tool"/>
      <Button x:Name="TextToolButton" Style="{StaticResource IconButton}" Width="30" Height="26" MinHeight="26" FontSize="13" Content="&#xE8D2;" Click="TextTool_Click" ToolTip="Text: click two spots to add a caption for that part" AutomationProperties.Name="Text tool"/>
      <Button x:Name="ImageToolButton" Style="{StaticResource IconButton}" Width="30" Height="26" MinHeight="26" FontSize="13" Content="&#xE8B9;" Click="ImageTool_Click" ToolTip="Picture: click two spots to add a picture or GIF for that part" AutomationProperties.Name="Picture tool"/>
      <Button x:Name="CropButton" Style="{StaticResource IconButton}" Width="30" Height="26" MinHeight="26" FontSize="13" Content="&#xE7A8;" Click="Crop_Click" ToolTip="Crop the video" AutomationProperties.Name="Crop video"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
      <Button x:Name="AddSectionButton" Style="{StaticResource IconButton}" Width="30" Height="26" MinHeight="26" FontSize="13" Content="&#xE710;" Click="Add_Click" Foreground="{DynamicResource Accent}" AutomationProperties.Name="Add section"/>
      <Button Style="{StaticResource IconButton}" Width="30" Height="26" MinHeight="26" FontSize="13" Content="&#xE8C6;" Click="Split_Click" ToolTip="Split the section under the playhead into two" AutomationProperties.Name="Split section"/>
      <Button Style="{StaticResource IconButton}" Width="30" Height="26" MinHeight="26" FontSize="13" Content="&#xE894;" Click="Clear_Click" ToolTip="Remove all sections" AutomationProperties.Name="Clear sections"/>
      <Button Style="{StaticResource IconButton}" Width="30" Height="26" MinHeight="26" FontSize="13" Content="&#xE7A7;" Click="Undo_Click" ToolTip="Undo" AutomationProperties.Name="Undo"/>
      <Button Style="{StaticResource IconButton}" Width="30" Height="26" MinHeight="26" FontSize="13" Content="&#xE7A6;" Click="Redo_Click" ToolTip="Redo" AutomationProperties.Name="Redo"/>
      <Button Style="{StaticResource IconButton}" Width="30" Height="26" MinHeight="26" FontSize="13" Content="&#xE768;" Click="Preview_Click" ToolTip="Play only the kept sections" AutomationProperties.Name="Preview sections" Foreground="{DynamicResource Accent}"/>
     </StackPanel>
    </StackPanel>
   </Border>
  </Grid>
  <Grid x:Name="RangeControls" Grid.Row="4" Margin="0,0,0,10" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <StackPanel x:Name="RangeFields" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed" IsKeyboardFocusWithinChanged="RangeFields_FocusChanged">
    <Border Width="3" Height="16" CornerRadius="2" Background="{DynamicResource Accent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
    <TextBox x:Name="StartBox" Width="112" Height="32" Text="0:00.000" TextChanged="RangeText_Changed" AutomationProperties.Name="Section start" FontSize="12" Padding="7,4" FontFamily="Consolas"/>
    <TextBlock Text="→" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,0"/>
    <Border Width="3" Height="16" CornerRadius="2" Background="#F3BF84" Margin="0,0,6,0" VerticalAlignment="Center"/>
    <TextBox x:Name="EndBox" Width="112" Height="32" TextChanged="RangeText_Changed" AutomationProperties.Name="Section end" FontSize="12" Padding="7,4" FontFamily="Consolas"/>
   </StackPanel>
   <DockPanel x:Name="SectionsRow" Grid.Column="1" Visibility="Collapsed">
    <ListBox x:Name="SectionsList" Height="34" AlternationCount="100" SelectionChanged="Section_Selected" BorderThickness="0" VerticalAlignment="Center" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled">
     <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Padding" Value="8,3,4,3"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/><Setter Property="ToolTip" Value="Click to edit this section"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal">
      <TextBlock Text="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ListBoxItem}, Converter={StaticResource PlusOne}}" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding CompactLabel}" VerticalAlignment="Center"/>
      <Button Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="8" Click="RemoveChip_Click" Tag="{Binding}" Width="20" Height="20" MinHeight="20" Padding="0" Margin="4,0,0,0" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Muted}" ToolTip="Remove this section" AutomationProperties.Name="Remove this section"/>
     </StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
  </Grid>
  <Border Grid.Row="6" BorderBrush="{DynamicResource Outline}" BorderThickness="0,1,0,0" Padding="0,10,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock x:Name="TotalLabel" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="StatusLabel" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
    <Button x:Name="ExportOptionsButton" Style="{StaticResource TrimButton}" Click="ExportOptions_Click" Background="Transparent" BorderBrush="Transparent" FontSize="12" Margin="0,0,6,0" ToolTip="Format, cut, size and audio options"><StackPanel Orientation="Horizontal"><TextBlock Text="Options" VerticalAlignment="Center"/><TextBlock x:Name="ExportOptionsChevron" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Margin="7,1,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/></StackPanel></Button>
    <Button Style="{StaticResource TrimButton}" x:Name="CancelExportButton" Content="Cancel" Click="CancelExport_Click" Visibility="Collapsed" Margin="0,0,8,0"/>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="ExportButton" Content="Export clip…" MinHeight="36" Padding="16,6" FontSize="13" Style="{StaticResource PrimaryButton}" Click="Export_Click"/>
     <Button x:Name="ExportMenuButton" Style="{StaticResource PrimaryButton}" MinHeight="36" Width="30" Padding="0" Margin="2,0,0,0" Click="ExportMenu_Click" ToolTip="Compress or copy" AutomationProperties.Name="More export choices"><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"/></Button>
    </StackPanel>
    <Popup x:Name="ExportMenuPopup" PlacementTarget="{Binding ElementName=ExportButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6" Closed="ExportMenuPopup_Closed">
     <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="8" Padding="4" MinWidth="200">
      <StackPanel>
       <Button x:Name="CopyButton" Style="{StaticResource TrimButton}" Click="CopyExport_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" FontSize="12" ToolTip="Export with the current options and copy the file, ready to paste" AutomationProperties.Name="Copy clip"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="18" VerticalAlignment="Center"/><TextBlock Text="Copy to clipboard" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
       <Button x:Name="CompressButton" Style="{StaticResource TrimButton}" Click="Compress_Click" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" FontSize="12" ToolTip="Make a smaller copy at a size you choose" AutomationProperties.Name="Compress"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE73F;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="18" VerticalAlignment="Center"/><TextBlock Text="Compress…" Margin="6,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
      </StackPanel>
     </Border>
    </Popup>
     <Popup x:Name="CompressPopup" PlacementTarget="{Binding ElementName=ExportButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6">
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="8" Padding="14" Width="300">
       <StackPanel>
        <DockPanel><TextBlock x:Name="CompressLabel" DockPanel.Dock="Right" Foreground="{DynamicResource Accent}" FontSize="12"/><TextBlock Text="Compress to" FontSize="13" FontWeight="SemiBold"/></DockPanel>
        <Slider x:Name="CompressSlider" Minimum="1" Maximum="100" Value="50" SmallChange="1" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="1" IsMoveToPointEnabled="True" Margin="0,10,0,4" ValueChanged="CompressSlider_Changed" AutomationProperties.Name="Target size in megabytes"/>
        <TextBlock x:Name="CompressHint" Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap"/>
        <Button Content="Compress" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinHeight="34" Padding="16,6" FontSize="12" Click="CompressGo_Click"/>
       </StackPanel>
      </Border>
     </Popup>
   </StackPanel>
   <Popup x:Name="ExportOptionsPopup" PlacementTarget="{Binding ElementName=ExportOptionsButton}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-6" Closed="ExportOptionsPopup_Closed">
    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Outline}" BorderThickness="1" CornerRadius="8" Padding="14,12" Width="330">
     <StackPanel x:Name="ExportOptionsPanel">
      <TextBlock Text="Export options" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Format" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
       <ComboBox x:Name="SharePreset" Grid.Column="1" MinHeight="32" SelectedIndex="0" SelectionChanged="Share_Changed" AutomationProperties.Name="Export format"><ComboBoxItem Content="MP4 · original quality"/><ComboBoxItem Content="MP4 · 1080p 60fps"/><ComboBoxItem Content="MP4 · 720p 30fps"/><ComboBoxItem Content="MOV · original quality"/><ComboBoxItem Content="GIF · 480p 15fps"/><ComboBoxItem Content="MP3 · audio only"/></ComboBox>
       <TextBlock Grid.Row="1" Text="Cut" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,6,0,0"/>
       <ComboBox x:Name="ExportMode" Grid.Row="1" Grid.Column="1" MinHeight="32" Margin="0,6,0,0" SelectedIndex="1" SelectionChanged="ExportMode_Changed" AutomationProperties.Name="Cut precision"><ComboBoxItem Content="Precise cut"/><ComboBoxItem Content="Rough cut · fast"/></ComboBox>
       <TextBlock Grid.Row="3" Text="Speed" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,6,0,0"/>
       <ComboBox x:Name="ExportSpeed" Grid.Row="3" Grid.Column="1" MinHeight="32" Margin="0,6,0,0" SelectedIndex="0" SelectionChanged="ExportSpeed_Changed" AutomationProperties.Name="Export speed" ToolTip="Slow motion for the whole export. Audio slows down without changing pitch."><ComboBoxItem Content="Normal speed"/><ComboBoxItem Content="0.75× · slow motion"/><ComboBoxItem Content="0.5× · slow motion"/><ComboBoxItem Content="0.25× · slow motion"/></ComboBox>
       <TextBlock Grid.Row="2" Text="Size limit" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,6,0,0"/>
       <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0"><TextBox x:Name="SizeLimit" Width="70" Height="32" Text="0" ToolTip="0 = no limit. MB uses 1,000,000 bytes; enter your upload limit." TextChanged="SizeLimit_Changed" AutomationProperties.Name="Size limit in megabytes"/><TextBlock Text="MB · 0 = no limit" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
      </Grid>
      <Grid x:Name="TrackMixPanel" Visibility="Collapsed" Margin="0,8,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Desktop" Style="{StaticResource Caption}" VerticalAlignment="Center"/>
       <Slider x:Name="DesktopMix" Grid.Column="1" Minimum="0" Maximum="200" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Mix_Changed" VerticalAlignment="Center" AutomationProperties.Name="Desktop audio volume"/>
       <TextBlock x:Name="DesktopMixLabel" Grid.Column="2" Text="100%" TextAlignment="Right" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
       <TextBlock Grid.Row="1" Text="Microphone" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,4,0,0"/>
       <Slider x:Name="MicrophoneMix" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="200" Value="100" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="Mix_Changed" VerticalAlignment="Center" Margin="0,4,0,0" AutomationProperties.Name="Microphone volume"/>
       <TextBlock x:Name="MicrophoneMixLabel" Grid.Row="1" Grid.Column="2" Text="100%" TextAlignment="Right" FontSize="11" VerticalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource Accent}"/>
      </Grid>
      <TextBlock x:Name="ModeHint" Text="Fast export; edges may extend to nearby keyframes." Foreground="{DynamicResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
     </StackPanel>
    </Border>
   </Popup>
   <ProgressBar x:Name="ExportProgress" Grid.Row="2" Grid.ColumnSpan="2" Minimum="0" Maximum="1" Height="3" Margin="0,8,0,0" Background="#303A42" Foreground="{DynamicResource Accent}"/>
  </Grid></Border>
 </Grid>
 <Grid x:Name="EmptyState" Margin="32"><Border BorderBrush="#46515D" BorderThickness="1" CornerRadius="14" Background="{DynamicResource Surface}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"><TextBlock Text="&#xE8C6;" FontFamily="Segoe MDL2 Assets" FontSize="34" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/><TextBlock Text="Drop a video to trim" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,20,0,8"/><TextBlock Text="MP4 · M4V · MOV" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center"/><Button Content="Open video…" Click="OpenVideo_Click" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,22,0,0"/><TextBlock x:Name="ImportStatus" Text="Your original stays unchanged." Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="20,18,20,0"/></StackPanel></Border></Grid>
 </Grid>
</DockPanel></Window>







